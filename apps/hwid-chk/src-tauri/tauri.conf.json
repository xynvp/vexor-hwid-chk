{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hwid-chk",
  "version": "1.0.0",
  "identifier": "support.vexor.hwidchk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HWID Verification",
        "width": 390,
        "height": 580,
        "minWidth": 390,
        "minHeight": 580,
        "devtools": false,
        "decorations": false,
        "shadow": true,
        "theme": "Dark",
        "backgroundColor": "#0a0a0b",
        "center": true,
        "resizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
